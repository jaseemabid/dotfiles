# https://just.systems
# Dependencies: op (1Password CLI), uv

set lazy

PASSWORD := `op read "op://Private/Raycast Settings Export/password"`
OUT := "/Users/j/Notes/Styx/Files/Raycast"

# Show available commands
@_default:
    just -u --list

# Decode config.data to config.json and keys.txt
@decode:
    PASSWORD="{{ PASSWORD }}" ./main.py --out {{ OUT }}
