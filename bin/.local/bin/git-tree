#!/bin/sh

if [ -t 1 ]; then
    color=always
else
    color=never
fi

git log \
    --graph \
    --boundary \
    --simplify-by-decoration \
    --branches \
    --remotes \
    "$@" \
    --color="$color" \
    --format='%x1f%C(auto)%h%d %s' \
| perl -Mutf8 -CSD -pe '
    if (s/^([^\x1f]*)\x1f//) {
        $graph = $1;
        $graph =~ tr{*|/\\}{●│╯╮};
        $_ = $graph . $_;
    } elsif (/^(?:(?:\e\[[0-9;]*m)|[*|\/\\\s])+$/) {
        tr{*|/\\}{●│╯╮};
    }
'
