#!/bin/sh

# Always open zed in a project if the file is part of a git root.

for arg do
    if [ "$arg" = '-' ]; then
        exec /opt/homebrew/bin/zed "$@"
    fi
done

root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$root" ]; then
    exec /opt/homebrew/bin/zed "$@" "$root"
fi

if [ "$#" -eq 0 ]; then
    exec /opt/homebrew/bin/zed .
fi

exec /opt/homebrew/bin/zed "$@"
