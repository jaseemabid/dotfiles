#!/usr/bin/env bash
# shellcheck disable=SC2016

set -euo pipefail

# re == Ripgrep Edit
# Tweaked version of https://github.com/junegunn/fzf/blob/master/ADVANCED.md#ripgrep-integration

# 1. Search for text in files using Ripgrep, passing down all arguments
# 2. Interactively narrow down the list using fzf
# 3. Open the file in editor and jump to the line
#
#
# ** NOTES **
#
# 1. rg prints 'path:line:text' and '--delimiter :' splits on those colons, so in
#    every fzf option below {1} is the matched file's path and {2} is the matched
#    line number. fzf single quotes both when it substitutes them, so they work as
#    arguments but cannot be used inside $(( )) — the arithmetic below deliberately
#    touches only env vars, never {2}.
#
# 2. '--line-range {2}::C' is bat's own "this line, with C lines of context either
#    side" form, clamped at both ends of the file, so the match lands mid preview and
#    needs no fzf scroll offset at all.
#
# 3. C is derived from $FZF_PREVIEW_LINES, the height of the preview pane, so the
#    context grows to fill the pane instead of being a fixed count. Subtract 4 for
#    bat's 3 header rows plus the matched line itself, then halve to split what's
#    left above and below. Bat's closing border row is deliberately not budgeted for,
#    so it falls just past the bottom of the pane rather than costing a line of
#    context.
#
# 4. --wrap=never keeps one rendered row per line, so the match lands at a predictable
#    row whatever the pane width. Overhanging text needs no handling here: fzf
#    truncates long preview lines itself rather than wrapping them.

rg --color=always --line-number --no-heading --smart-case "$@" |
  fzf --ansi \
      --color "hl:-1:underline,hl+:-1:underline:reverse" \
      --delimiter : --reverse \
      --preview 'bat --color=always {1} --highlight-line {2} --wrap=never --line-range {2}::$(( (FZF_PREVIEW_LINES - 4) / 2 ))' \
      --preview-window 'bottom,60%,border-none' \
      --tmux 'center,95%,50%' \
      --bind 'enter:become(zed {1}:{2})'
