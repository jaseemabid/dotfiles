// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "cmd-alt-o": null, // Use ⌃r or Space+p+r for projects::OpenRecent
      "cmd-o": "file_finder::Toggle",
      "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "alt-c": ["task::Spawn", { "task_name": "Copy zed:// link" }],
      "space a": "editor::ToggleCodeActions",
      "space o": "outline::Toggle",
      "space shift-p": "editor::GoToDefinitionSplit",
      "space p r": "projects::OpenRecent",
      "space r": "editor::Rename",
      "space shift-o": "project_symbols::Toggle",
      "space shift-r": "editor::ReloadFile",
      "space t": "task::Spawn",
      "space y l": ["task::Spawn", { "task_name": "Copy zed:// link" }],
      "space y p": "workspace::CopyRelativePath",
      "space y shift-p": "workspace::CopyPath",
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      // Unbind bare "space" (vim::WrappingRight) so the which-key popup persists
      // after pressing the leader; see zed-industries/zed#48783.
      "space": null,

      // Unbind default "g r" LSP subgroup entirely — now covered by space-prefix.
      "g r n": null,
      "g r r": null,
      "g r i": null,
      "g r a": null
    }
  }
]
