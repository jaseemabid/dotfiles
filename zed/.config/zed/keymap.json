// Zed keymap
//
// Zed docs: https://zed.dev/docs/key-bindings
// Run `vim::OpenDefaultKeymap` to see vim key map
// Run `zed::OpenDefaultKeymap` for default key map

[
  {
    "bindings": {
      "cmd-alt-o": null, // Use ⌃r or Space+p+r for projects::OpenRecent
      "cmd-o": "file_finder::Toggle",
      "shift shift": "file_finder::Toggle",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // Navigation and projects
      "space O": "project_symbols::Toggle",
      "space P": "editor::GoToDefinitionSplit",
      "space g o": "editor::OpenPermalinkToLine", // Open Git line/selection permalink
      "space o": "outline::Toggle",
      "space p r": "projects::OpenRecent",

      // Editing and tasks
      "space a": "editor::ToggleCodeActions",
      "space r": "editor::Rename",
      "space R": "editor::ReloadFile",
      "space t": "task::Spawn",

      // Copy zed:// links
      "alt-c": ["task::Spawn", { "task_name": "Copy zed:// link" }],
      "space y l": ["task::Spawn", { "task_name": "Copy zed:// link" }], // Local file + line + column

      // Copy absolute and relative file paths
      "space y P": "workspace::CopyPath",
      "space y p": "workspace::CopyRelativePath",

      // Copy git permalink
      // NOTE: git::CopyFilePermalink and git::OpenFilePermalink are panel-only actions.
      "space y g": "editor::CopyPermalinkToLine",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      // Unbind bare "space" (vim::WrappingRight) so the which-key popup persists
      // after pressing the leader; see zed-industries/zed#48783.
      "space": null,

      // Unbind default "g r" LSP subgroup entirely — now covered by space-prefix.
      "g r n": null,
      "g r r": null,
      "g r i": null,
      "g r a": null,
    },
  },
]
