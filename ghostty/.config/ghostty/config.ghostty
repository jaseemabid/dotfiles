# Config generated by Ghostty Config
# https://ghostty.zerebos.com
# Reload with ⇧⌘,

# Appearance and selection
font-family = MesloLGS NF
theme = Catppuccin Mocha
copy-on-select = clipboard
macos-icon = chalkboard

# Window behaviour
macos-applescript = false
quick-terminal-position = center
quick-terminal-size = 80%,30%
quit-after-last-window-closed = true

# One-shot tmux/Kitty-style leaders. Keep Ghostty's default shortcuts too.
keybind = §=activate_key_table_once:leader
keybind = ctrl+b=activate_key_table_once:leader
keybind = leader/escape=deactivate_key_table
keybind = leader/catch_all=deactivate_key_table

# Splits: \ and | split right; - and _ split down.
keybind = leader/backslash=new_split:right
keybind = leader/shift+backslash=new_split:right
keybind = leader/minus=new_split:down
keybind = leader/shift+minus=new_split:down

keybind = leader/h=goto_split:left
keybind = leader/j=goto_split:down
keybind = leader/k=goto_split:up
keybind = leader/l=goto_split:right

keybind = leader/shift+h=resize_split:left,10
keybind = leader/shift+j=resize_split:down,10
keybind = leader/shift+k=resize_split:up,10
keybind = leader/shift+l=resize_split:right,10

keybind = leader/x=close_surface
keybind = leader/z=toggle_split_zoom
keybind = leader/shift+e=equalize_splits

# Tabs
keybind = leader/c=new_tab
keybind = leader/shift+x=close_tab:this
keybind = leader/1=goto_tab:1
keybind = leader/2=goto_tab:2
keybind = leader/3=goto_tab:3
keybind = leader/4=goto_tab:4
keybind = leader/5=goto_tab:5
keybind = leader/6=goto_tab:6
keybind = leader/7=goto_tab:7
keybind = leader/8=goto_tab:8
keybind = leader/9=goto_tab:9
keybind = leader/0=goto_tab:10

# Tools: : opens the command palette; [ searches scrollback.
keybind = leader/shift+semicolon=toggle_command_palette
keybind = leader/bracket_left=start_search

# Direct tab switching, matching Kitty and tmux.
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9
keybind = alt+0=goto_tab:10
